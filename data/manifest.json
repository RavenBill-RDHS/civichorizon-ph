      "reference_date": null,
      "status": "active",
      "enabled": true,
      "path": "./data/datasets/community_listings.json",
      "format": "json",
      "entity_type": "place",
      "concept": "community_listings",
      "location_fields": [
        "psgc_code"
      ],
      "required_fields": [
        "listing_id",
        "name",
        "psgc_code",
        "latitude",
        "longitude",
        "place_type"
