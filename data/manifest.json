      "enabled": true,
      "path": "./data/datasets/housing_places_osm.json",
      "format": "json",
      "entity_type": "accommodation",
      "concept": "housing_listings",
      "location_fields": [
        "psgc_code"
      ],
      "required_fields": [
        "listing_id",
        "name",
