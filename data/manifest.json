  "concepts": [
    "location_identity",
    "population",
    "area",
    "population_density",
    "classification",
    "schools",
    "hospitals",
    "roads",
    "transport",
    "flood_hazards",
    "businesses",
    "housing",
    "rental_prices",
    "development",
    "land_use",
    "infrastructure",
    "demographics",
    "housing_listings",
    "community_listings"
  ],
  "provenance_schema": [
    "dataset_id",
    "name",
    "provider",
    "reference_date",
    "method",
    "confidence"
  ],
  "dataset_contract_version": "1.3.0",
  "geographic_join": {
    "primary_key": "psgc_code",
    "fallback_keys": [
      "location_id",
      "correspondence_code"
    ],
    "descendant_expansion": true,
    "name_matching": "opt-in only",
    "strict_mode": true
  },
  "validation": {
    "strict_json": true,
    "required_metadata": [
      "dataset_id",
      "name",
      "provider"
    ],
    "stable_location_fields": [
      "psgc_code",
      "psgcCode",
      "PSGC",
      "location_id",
      "locationId",
      "correspondence_code",
      "correspondenceCode"
    ],
    "optional_name_matching": false,
    "duplicate_detection": "unique_field when configured"
  },
  "ingestion": {
    "phase": "active",
    "workspace": "local admin workspace",
    "supported_source_formats": [
      "csv",
      "json"
    ],
    "pdf_intake": "metadata-only; extract tables to CSV/JSON before import",
    "outputs": [
      "validated JSON dataset",
      "manifest dataset definition"
    ],
    "workflow": [
      "load source",
      "map fields",
      "validate contract",
      "inspect geographic joins",
      "download JSON",
      "add dataset definition to manifest",
      "repair and normalize source data",
      "review community submissions",
      "publish approved place records"
    ]
  }
}
