        "location_id"
      ]
    },
    {
      "dataset_id": "psa_cph_housing_2020_region",
      "name": "Housing Characteristics — 2020 CPH (Regional)",
      "provider": "Philippine Statistics Authority (PSA)",
      "reference_date": "2020-05-01",
      "status": "active",
      "enabled": true,
      "path": "./data/datasets/psa_cph_housing_2020_region.json",
      "format": "json",
      "entity_type": "housing_profile",
      "concept": "housing",
      "location_fields": [
